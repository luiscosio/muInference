# Dockerfile for security analysis and LOC comparison tools
#
# This container includes cloc, scc, trivy for security/LOC analysis.
#
# Usage:
#   docker build -f docker/Dockerfile.tools -t muinference-tools .
#   docker run -v $(pwd):/workspace muinference-tools loc
#   docker run -v $(pwd):/workspace muinference-tools security

FROM ubuntu:22.04

LABEL maintainer="muinference"
LABEL description="Security analysis and LOC tools for muinference"

ENV DEBIAN_FRONTEND=noninteractive

# Install base tools
RUN apt-get update && apt-get install -y \
    cloc \
    curl \
    git \
    python3 \
    python3-pip \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install scc (fast LOC counter)
RUN curl -sL https://github.com/boyter/scc/releases/download/v3.2.0/scc_Linux_x86_64.tar.gz \
    | tar xz -C /usr/local/bin

# Install trivy (vulnerability scanner)
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
    | sh -s -- -b /usr/local/bin v0.50.0

WORKDIR /workspace

# Copy analysis scripts
COPY docker/analyze.sh /usr/local/bin/analyze
COPY docker/analyze_attack_surface.sh /usr/local/bin/analyze_attack_surface
RUN chmod +x /usr/local/bin/analyze /usr/local/bin/analyze_attack_surface

ENTRYPOINT ["/usr/local/bin/analyze"]
CMD ["help"]
