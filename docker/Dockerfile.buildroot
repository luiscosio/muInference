# Dockerfile for building Buildroot-based muinference enclave
#
# This container handles all build steps. Uses Docker volume for caching.
#
# Usage:
#   docker compose -f docker-compose.build.yml run buildroot
#
# Caching:
#   - Buildroot source and build artifacts are cached in a Docker volume
#   - Subsequent builds are much faster
#   - To force full rebuild: docker compose -f docker-compose.build.yml build --no-cache buildroot

FROM ubuntu:22.04

LABEL maintainer="muinference"
LABEL description="Buildroot build environment for muinference enclave"

ENV DEBIAN_FRONTEND=noninteractive

# Install Buildroot dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    curl \
    cpio \
    unzip \
    rsync \
    bc \
    libncurses5-dev \
    libssl-dev \
    libelf-dev \
    python3 \
    python3-pip \
    file \
    locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

WORKDIR /home/builder

# Copy project files
COPY . /home/builder/muinference

# Make scripts executable
RUN chmod +x /home/builder/muinference/scripts/*.sh 2>/dev/null || true

WORKDIR /home/builder/muinference

# Default command: build the enclave
CMD ["./scripts/build_buildroot_enclave.sh"]
