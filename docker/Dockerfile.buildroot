# Dockerfile for building Buildroot-based muinference enclave
#
# This container handles all Linux-specific build steps without requiring WSL.
#
# Usage:
#   docker build -f docker/Dockerfile.buildroot -t muinference-builder .
#   docker run -v $(pwd)/output:/output muinference-builder

FROM ubuntu:22.04

LABEL maintainer="muinference"
LABEL description="Buildroot build environment for muinference enclave"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Buildroot dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    curl \
    cpio \
    unzip \
    rsync \
    bc \
    libncurses5-dev \
    libssl-dev \
    python3 \
    python3-pip \
    file \
    locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Create build user (Buildroot doesn't like running as root)
RUN useradd -m -s /bin/bash builder
WORKDIR /home/builder

# Copy project files
COPY --chown=builder:builder . /home/builder/muinference

USER builder
WORKDIR /home/builder/muinference

# Build script
RUN chmod +x scripts/*.sh 2>/dev/null || true

# Default command: build the enclave
CMD ["./scripts/build_buildroot_enclave.sh"]
